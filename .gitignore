# Ignore local database files (a broad *.json would hide .aikit/ memory)
*_db.json
personnel_db_*.json
# Quarantined copies of unreadable local state keep the same private data
*_db.json.corrupt_*
personnel_db_*.json.corrupt_*

# Ignore Streamlit secrets
.streamlit/secrets.toml

# Ignore Python cache
__pycache__/
*.pyc

# Runtime-downloaded PDF fonts
Roboto-*.ttf

# AIKit transient state
.aikit/*.lock
.aikit/*.bak
.aikit/*.tmp_*
.aikit/*.corrupt_*
# Reforge run artifacts (review packets stay local; the run state is committed)
.aikit/reforge.reviews/
